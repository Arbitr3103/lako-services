---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const modeInvoice = t(locale, 'efaktura.hero.modeInvoice');
const modeDeliveryNote = t(locale, 'efaktura.hero.modeDeliveryNote');
const previewLabel = t(locale, 'efaktura.studio.preview');
const formLabel = t(locale, 'efaktura.studio.form');
const sellerLabel = t(locale, 'efaktura.studio.seller');
const buyerLabel = t(locale, 'efaktura.studio.buyer');
const itemsLabel = t(locale, 'efaktura.studio.items');
const invoiceNumberLabel = t(locale, 'efaktura.studio.invoiceNumber');
const issueDateLabel = t(locale, 'efaktura.studio.issueDate');
const totalLabel = t(locale, 'efaktura.studio.total');
const amountLabel = t(locale, 'efaktura.studio.amount');
---

<div class="relative">
  <div class="absolute -left-10 top-8 h-40 w-40 rounded-full bg-primary/18 blur-3xl"></div>
  <div class="absolute -right-4 bottom-0 h-32 w-32 rounded-full bg-accent/18 blur-3xl"></div>

  <div class="relative overflow-hidden rounded-[26px] border border-white/10 bg-[#09111d]/95 shadow-[0_30px_120px_rgba(11,17,32,0.75)] sm:rounded-[30px]">
    <div class="flex items-center justify-between border-b border-white/8 px-4 py-3 sm:px-5 sm:py-4">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
      </div>
      <div class="flex items-center gap-1.5 rounded-full border border-white/8 bg-white/4 p-1 text-[10px] font-semibold text-text-light sm:gap-2 sm:text-[11px]">
        <span class="rounded-full bg-accent px-2.5 py-1 text-white sm:px-3">{modeInvoice}</span>
        <span class="rounded-full px-2.5 py-1 sm:px-3">{modeDeliveryNote}</span>
      </div>
    </div>

    <div class="grid gap-0 lg:grid-cols-[0.92fr_1.08fr]">
      <div class="border-b border-white/8 bg-white/[0.02] p-4 sm:p-5 lg:border-b-0 lg:border-r">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-[0.24em] text-text-muted">{formLabel}</span>
          <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 text-[11px] font-medium text-emerald-300">92%</span>
        </div>

        <div class="space-y-4">
          <div class="rounded-2xl border border-white/8 bg-[#0d1627] p-3.5 sm:p-4">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-sm font-semibold text-text">{sellerLabel}</span>
              <span class="rounded-full bg-primary/12 px-2 py-1 text-[11px] font-medium text-primary">PIB</span>
            </div>
            <div class="space-y-2">
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-sm text-text">Lako Services d.o.o.</div>
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-sm text-text-light">Bulevar oslobodjenja 15, Novi Sad</div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/8 bg-[#0d1627] p-3.5 sm:p-4">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-sm font-semibold text-text">{buyerLabel}</span>
              <span class="rounded-full bg-primary/12 px-2 py-1 text-[11px] font-medium text-primary">VAT</span>
            </div>
            <div class="space-y-2">
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-sm text-text">Kupac Trade d.o.o.</div>
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-sm text-text-light">PIB 109234567</div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/8 bg-[#0d1627] p-3.5 sm:p-4">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-sm font-semibold text-text">{itemsLabel}</span>
              <span class="rounded-full bg-accent/12 px-2 py-1 text-[11px] font-medium text-accent">UBL</span>
            </div>
            <div class="grid gap-2 sm:grid-cols-2">
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-xs text-text-light">
                <span class="mb-1 block text-[11px] uppercase tracking-[0.16em] text-text-muted">{invoiceNumberLabel}</span>
                INV-2026-041
              </div>
              <div class="rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-xs text-text-light">
                <span class="mb-1 block text-[11px] uppercase tracking-[0.16em] text-text-muted">{issueDateLabel}</span>
                07.04.2026
              </div>
            </div>
            <div class="mt-2 rounded-xl border border-white/6 bg-white/[0.03] px-3 py-2 text-xs text-text-light">
              Transport service · 1 × 48,000 RSD · VAT 20%
            </div>
          </div>
        </div>
      </div>

      <div class="bg-[linear-gradient(180deg,rgba(96,165,250,0.09),rgba(11,17,32,0))] p-4 sm:p-5">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-[0.24em] text-text-muted">{previewLabel}</span>
          <div class="flex items-center gap-2 text-[11px] font-medium text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            PDF + XML ready
          </div>
        </div>

        <div class="rounded-[24px] border border-slate-200/60 bg-white p-4 text-slate-900 shadow-[0_24px_50px_rgba(15,23,42,0.18)] sm:rounded-[26px] sm:p-5">
          <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-4">
            <div>
              <div class="text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400">e-Faktura Studio</div>
              <h3 class="mt-2 text-xl font-bold sm:text-2xl">SEF Invoice</h3>
              <p class="mt-1 text-xs text-slate-500">PDF for the buyer, XML for the portal, QR for verification.</p>
            </div>
            <div class="grid h-14 w-14 grid-cols-3 gap-1 rounded-2xl bg-slate-900 p-2 sm:h-16 sm:w-16">
              {Array.from({ length: 9 }).map((_, i) => (
                <span class:list={['rounded-[3px]', i % 2 === 0 ? 'bg-white' : 'bg-slate-900']}></span>
              ))}
            </div>
          </div>

          <div class="mt-4 grid gap-3 text-xs text-slate-600 sm:grid-cols-3">
            <div class="rounded-2xl bg-slate-100 px-3 py-2">
              <span class="mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">{sellerLabel}</span>
              Lako Services
            </div>
            <div class="rounded-2xl bg-slate-100 px-3 py-2">
              <span class="mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">{buyerLabel}</span>
              Kupac Trade
            </div>
            <div class="rounded-2xl bg-slate-100 px-3 py-2">
              <span class="mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">{totalLabel}</span>
              57,600 RSD
            </div>
          </div>

          <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
            <div class="grid grid-cols-[1.5fr_0.5fr_0.7fr] bg-slate-100 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">
              <span>{itemsLabel}</span>
              <span class="text-center">VAT</span>
              <span class="text-right">{amountLabel}</span>
            </div>
            <div class="grid grid-cols-[1.5fr_0.5fr_0.7fr] px-4 py-3 text-sm text-slate-700">
              <span>Transport service Novi Sad → Belgrade</span>
              <span class="text-center">20%</span>
              <span class="text-right font-semibold">48,000</span>
            </div>
            <div class="grid grid-cols-[1.5fr_0.5fr_0.7fr] border-t border-slate-200 px-4 py-3 text-sm text-slate-700">
              <span>Delivery note + QR verification</span>
              <span class="text-center">0%</span>
              <span class="text-right font-semibold">9,600</span>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-end">
            <div class="w-full max-w-[190px] rounded-2xl bg-slate-900 px-4 py-3 text-white">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span>{totalLabel}</span>
                <span>RSD</span>
              </div>
              <div class="mt-1 text-2xl font-bold">57,600</div>
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">PDF</span>
          <span class="rounded-full border border-accent/20 bg-accent/10 px-3 py-1.5 text-xs font-medium text-accent">UBL XML</span>
          <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1.5 text-xs font-medium text-emerald-300">QR delivery note</span>
        </div>
      </div>
    </div>
  </div>
</div>
