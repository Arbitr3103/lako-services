---
import { getLocalizedPath, type Locale } from '../i18n/utils';

interface Props {
  class?: string;
  locale: Locale;
}
const { class: className = '', locale } = Astro.props;
---
<a href={getLocalizedPath('/', locale)} class:list={["inline-flex items-center gap-0.5 text-2xl font-bold tracking-tight", className]}>
  <span class="text-primary">Lako</span><span class="text-accent">.</span>
</a>
